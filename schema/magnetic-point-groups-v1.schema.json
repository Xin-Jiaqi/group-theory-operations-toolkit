{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xin-Jiaqi/group-theory-operations-toolkit/raw/main/schema/magnetic-point-groups-v1.schema.json",
  "title": "Magnetic Point Groups v1",
  "type": "object",
  "required": [
    "schema_version",
    "point_group_registry_sha256",
    "operation_catalog_sha256",
    "generated_by",
    "sources",
    "conventions",
    "magnetic_point_groups"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "point_group_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_by": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["title", "url", "role"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "role": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "conventions": {
      "type": "object",
      "required": ["magnetic_number", "time_reversal", "construction", "setting"],
      "properties": {
        "magnetic_number": {"type": "string", "minLength": 1},
        "time_reversal": {"type": "string", "minLength": 1},
        "construction": {"type": "string", "minLength": 1},
        "setting": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "magnetic_point_groups": {
      "type": "array",
      "minItems": 122,
      "maxItems": 122,
      "items": {
        "type": "object",
        "required": [
          "number",
          "magnetic_number",
          "hm_symbol",
          "category",
          "parent_point_group_number",
          "parent_point_group_hm",
          "crystal_system",
          "host_family",
          "order",
          "unitary_subgroup_order",
          "generators",
          "operations"
        ],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 122},
          "magnetic_number": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
          "hm_symbol": {"type": "string", "minLength": 1},
          "category": {"enum": ["type_I", "type_II_gray", "type_III_black_white"]},
          "parent_point_group_number": {"type": "integer", "minimum": 1, "maximum": 32},
          "parent_point_group_hm": {"type": "string", "minLength": 1},
          "crystal_system": {
            "enum": ["triclinic", "monoclinic", "orthorhombic", "tetragonal", "trigonal", "hexagonal", "cubic"]
          },
          "host_family": {"enum": ["cubic_Oh", "tetragonal_D4h", "hexagonal_D6h"]},
          "order": {"type": "integer", "minimum": 1, "maximum": 96},
          "unitary_subgroup_order": {"type": "integer", "minimum": 1, "maximum": 48},
          "generators": {"type": "array", "items": {"$ref": "#/$defs/magneticOperation"}},
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 96,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/magneticOperation"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "magneticOperation": {
      "type": "object",
      "required": ["name", "time_reversal"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "time_reversal": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
