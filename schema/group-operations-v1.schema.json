{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xin-Jiaqi/group-theory-operations-toolkit/raw/main/schema/group-operations-v1.schema.json",
  "title": "Group Theory Operations Catalog v1",
  "type": "object",
  "required": ["schema_version", "title", "conventions", "families"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "conventions": {"type": "object"},
    "families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/family"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "matrix3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"type": "number"}
      }
    },
    "operation": {
      "type": "object",
      "required": ["index", "name", "matrix_fractional", "matrix_cartesian"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "source_name": {"type": "string", "minLength": 1},
        "xyz": {"type": "string"},
        "xyz_fractional": {"type": "string"},
        "ita": {"type": ["string", "null"]},
        "seitz": {"type": ["string", "null"]},
        "matrix_fractional": {"$ref": "#/$defs/matrix3"},
        "matrix_cartesian": {"$ref": "#/$defs/matrix3"},
        "matrix_cartesian_exact": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "string"}
          }
        }
      },
      "additionalProperties": true
    },
    "point_group": {
      "type": "object",
      "required": ["name", "order", "operations", "operation_indices"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "operation_indices": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "layer_group": {
      "type": "object",
      "required": ["LG", "point_group", "point_group_base", "R+", "R-", "R+_indices", "R-_indices"],
      "properties": {
        "LG": {"type": "integer", "minimum": 1, "maximum": 80},
        "point_group": {"type": "string", "minLength": 1},
        "point_group_base": {"type": "string", "minLength": 1},
        "point_group_embedding": {"type": "string", "minLength": 1},
        "R+": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "R-": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "R+_indices": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "R-_indices": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "multiplication": {
      "type": "object",
      "required": ["convention", "identity", "element_order", "inverse", "table"],
      "properties": {
        "convention": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "display_aliases": {"type": "object", "additionalProperties": {"type": "string"}},
        "element_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "basis_used_for_exact_generation": {"type": "string"},
        "element_order_note": {"type": "string"},
        "inverse": {"type": "object", "additionalProperties": {"type": "string"}},
        "table": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": ["crystal_system", "parent_point_group", "basis", "operations", "point_groups", "layer_groups"],
      "properties": {
        "crystal_system": {"type": "string", "minLength": 1},
        "parent_point_group": {"type": "string", "minLength": 1},
        "basis": {"type": "object"},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
        "point_groups": {"type": "array", "items": {"$ref": "#/$defs/point_group"}},
        "layer_groups": {"type": "array", "items": {"$ref": "#/$defs/layer_group"}},
        "multiplication": {"$ref": "#/$defs/multiplication"}
      },
      "additionalProperties": false
    }
  }
}
